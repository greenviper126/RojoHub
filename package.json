    "viewsContainers": {
      "activitybar": [
        {
          "id": "rojoHub",
          "title": "Rojo-Hub",
          "icon": "media/hub.svg"
        }
      ]
    },
    "views": {
      "rojoHub": [
        {
          "id": "rojoHub.panel",
          "name": "Rojo-Hub",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "rojoHub.openMenu",
        "title": "Open Menu",
        "category": "Rojo-Hub",
        "icon": "$(list-selection)"
      },
      {
        "command": "rojoHub.projectMenu",
        "title": "Project Menu",
        "category": "Rojo-Hub"
      },
      {
        "command": "rojoHub.addProject",
        "title": "Add Project",
        "category": "Rojo-Hub",
        "icon": "$(add)"
      },
      {
        "command": "rojoHub.removeProject",
        "title": "Remove Project",
        "category": "Rojo-Hub",
        "icon": "$(trash)"
      },
      {
        "command": "rojoHub.start",
        "title": "Start Serving",
        "category": "Rojo-Hub",
        "icon": "$(play)"
      },
      {
        "command": "rojoHub.stop",
        "title": "Stop Serving",
        "category": "Rojo-Hub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "rojoHub.switch",
        "title": "Switch Branch",
        "category": "Rojo-Hub",
        "icon": "$(git-branch)"
      },
      {
        "command": "rojoHub.showLog",
        "title": "Show Rojo Log",
        "category": "Rojo-Hub",
        "icon": "$(output)"
      },
      {
        "command": "rojoHub.copyAddress",
        "title": "Copy Port",
        "category": "Rojo-Hub"
      },
      {
        "command": "rojoHub.refresh",
        "title": "Refresh",
        "category": "Rojo-Hub",
        "icon": "$(refresh)"
      },
      {
        "command": "rojoHub.newGroup",
        "title": "New Group",
        "category": "Rojo-Hub",
        "icon": "$(new-folder)"
      },
      {
        "command": "rojoHub.editGroup",
        "title": "Rename Group",
        "category": "Rojo-Hub",
        "icon": "$(edit)"
      },
      {
        "command": "rojoHub.deleteGroup",
        "title": "Delete Group",
        "category": "Rojo-Hub",
        "icon": "$(trash)"
      },
      {
        "command": "rojoHub.startGroup",
        "title": "Start Group",
        "category": "Rojo-Hub",
        "icon": "$(play)"
      },
      {
        "command": "rojoHub.stopGroup",
        "title": "Stop Group",
        "category": "Rojo-Hub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "rojoHub.groupMenu",
        "title": "Group Menu",
        "category": "Rojo-Hub"
      },
      {
        "command": "rojoHub.addToGroup",
        "title": "Add Project to Group",
        "category": "Rojo-Hub",
        "icon": "$(add)"
      },
      {
        "command": "rojoHub.focusProject",
        "title": "Show Project in Panel",
        "category": "Rojo-Hub"
      },
      {
        "command": "rojoHub.collapseAll",
        "title": "Collapse All",
        "category": "Rojo-Hub",
        "icon": "$(collapse-all)"
      },
      {
        "command": "rojoHub.fold.expand",
        "title": "Expand",
        "category": "Rojo-Hub"
      },
      {
        "command": "rojoHub.fold.collapse",
        "title": "Collapse",
        "category": "Rojo-Hub"
      },
      {
        "command": "rojoHub.fold.collapseOthers",
        "title": "Collapse Others",
        "category": "Rojo-Hub"
      },
      {
        "command": "rojoHub.fold.expandAll",
        "title": "Expand All",
        "category": "Rojo-Hub"
      },
      {
        "command": "rojoHub.stopAll",
        "title": "Stop All",
        "category": "Rojo-Hub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "rojoHub.copyAgentCommands",
        "title": "Copy Agent Setup Commands",
        "category": "Rojo-Hub",
        "icon": "$(terminal)"
      },
      {
        "command": "rojoHub.copyAgentPrompt",
        "title": "Copy Agent Setup Prompt",
        "category": "Rojo-Hub",
        "icon": "$(comment)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rojoHub.openMenu",
          "when": "view == rojoHub.panel",
          "group": "navigation@0"
        },
        {
          "command": "rojoHub.refresh",
          "when": "view == rojoHub.panel",
          "group": "navigation@1"
        },
        {
          "command": "rojoHub.collapseAll",
          "when": "view == rojoHub.panel",
          "group": "navigation@2"
        },
        {
          "command": "rojoHub.addProject",
          "when": "view == rojoHub.panel",
          "group": "1@1"
        },
        {
          "command": "rojoHub.newGroup",
          "when": "view == rojoHub.panel",
          "group": "1@2"
        },
        {
          "command": "rojoHub.stopAll",
          "when": "view == rojoHub.panel",
          "group": "zz"
        }
      ],
      "webview/context": [
        {
          "command": "rojoHub.fold.expand",
          "when": "webviewId == 'rojoHub.panel' && rojoHubFold == 'folded'",
          "group": "fold@1"
        },
        {
          "command": "rojoHub.fold.collapse",
          "when": "webviewId == 'rojoHub.panel' && rojoHubFold == 'open'",
          "group": "fold@1"
        },
        {
          "command": "rojoHub.fold.collapseOthers",
          "when": "webviewId == 'rojoHub.panel' && rojoHubFold",
          "group": "fold@3"
        },
        {
          "command": "rojoHub.fold.expandAll",
          "when": "webviewId == 'rojoHub.panel' && rojoHubFoldNests",
          "group": "fold@2"
        }
      ],
      "commandPalette": [
        {
          "command": "rojoHub.fold.expand",
          "when": "false"
        },
        {
          "command": "rojoHub.fold.collapse",
          "when": "false"
        },
        {
          "command": "rojoHub.fold.collapseOthers",
          "when": "false"
        },
        {
          "command": "rojoHub.fold.expandAll",
          "when": "false"
        },
        {
          "command": "rojoHub.projectMenu",
          "when": "false"
        },
        {
          "command": "rojoHub.addProject",
          "when": "false"
        },
        {
          "command": "rojoHub.removeProject",
          "when": "false"
        },
        {
          "command": "rojoHub.start",
          "when": "false"
        },
        {
          "command": "rojoHub.stop",
          "when": "false"
        },
        {
          "command": "rojoHub.switch",
          "when": "false"
        },
        {
          "command": "rojoHub.showLog",
          "when": "false"
        },
        {
          "command": "rojoHub.copyAddress",
          "when": "false"
        },
        {
          "command": "rojoHub.refresh",
          "when": "false"
        },
        {
          "command": "rojoHub.newGroup",
          "when": "false"
        },
        {
          "command": "rojoHub.editGroup",
          "when": "false"
        },
        {
          "command": "rojoHub.deleteGroup",
          "when": "false"
        },
        {
          "command": "rojoHub.startGroup",
          "when": "false"
        },
        {
          "command": "rojoHub.stopGroup",
          "when": "false"
        },
        {
          "command": "rojoHub.groupMenu",
          "when": "false"
        },
        {
          "command": "rojoHub.addToGroup",
          "when": "false"
        },
        {
          "command": "rojoHub.focusProject",
          "when": "false"
        },
        {
          "command": "rojoHub.collapseAll",
          "when": "false"
        },
        {
          "command": "rojoHub.stopAll",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Rojo-Hub",
      "properties": {
        "rojoHub.excludedPorts": {
          "type": "array",
          "scope": "application",
          "default": [],
          "items": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^\\s*\\d+\\s*(-\\s*\\d+\\s*)?$",
            "patternErrorMessage": "Write a port (35000) or a range (\"35000-35010\")."
          },
          "markdownDescription": "Ports Rojo-Hub never gives to any project, across all projects. Each entry is a port (`35000`) or a range (`\"35000-35010\"`). Port 34872 (Rojo's default) and 34870 (Rojo-Hub's service) are always excluded. A project file's `servePort` still wins. A running project whose port changes is restarted on its new port."
        },
        "rojoHub.sourcemaps": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "markdownDescription": "Keep `sourcemap.json` up to date in the worktree each serving project serves, with its pinned `rojo sourcemap --watch`, whether or not luau-lsp or VS Code is open. It writes the same file luau-lsp's extension does, and only where `sourcemap.json` is gitignored or already exists."
        },
        "rojoHub.studioPlugin": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "markdownDescription": "Keep Rojo-Hub's Studio plugin (Rojo's plugin, changed to connect by itself) in Studio's local plugins folder, and take out other `RojoHub*.rbxm` copies. It syncs each place with the project whose `servePlaceIds` lists it, or the project it last synced with, and reconnects after Rojo restarts. Turn off to manage the plugin yourself; Rojo-Hub then leaves the folder alone."
        },
        "rojoHub.notifyOnStudioDisconnect": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "markdownDescription": "Show a message when Studio disconnects from a serving project. It appears in the window that has the project open, or else in the focused window."
        },
        "rojoHub.portRange": {
          "type": "string",
          "scope": "application",
          "default": "34873-35872",
          "pattern": "^\\s*\\d+\\s*-\\s*\\d+\\s*$",
          "patternErrorMessage": "Write the range as first-last, for example 34873-35872.",
          "markdownDescription": "Ports Rojo-Hub picks from, as `first-last`. Each project gets a port worked out from its repo's first commit, so it is the same on every machine. A project whose project file sets `servePort` uses that instead."
        },
        "rojoHub.agents": {
          "type": "object",
          "scope": "application",
          "ignoreSync": true,
          "additionalProperties": false,
          "properties": {
            "vscode": {
              "type": "boolean",
              "default": true,
              "description": "VS Code's own agents (Copilot and others). Registered with VS Code while Rojo-Hub is installed; nothing is written to disk."
            },
            "claudeCode": {
              "type": "boolean",
              "default": false,
              "description": "Claude Code, in any terminal or Orca: adds rojohub to its user config (claude mcp add --scope user)."
            },
            "codex": {
              "type": "boolean",
              "default": false,
              "description": "Codex: adds rojohub to its config.toml in CODEX_HOME, normally ~/.codex (codex mcp add)."
            }
          },
          "default": {
            "vscode": true,
            "claudeCode": false,
            "codex": false
          },
          "markdownDescription": "Which AI agents can use Rojo-Hub's tools (an MCP server at `http://127.0.0.1:34870/mcp`), so they can serve their own worktree to Studio, live, without restarting Rojo. Unticking takes Rojo-Hub out of that agent's config again, and so does uninstalling Rojo-Hub. An entry named `rojohub` that points elsewhere is never touched.\n\nAnother agent? [Copy setup commands](command:rojoHub.copyAgentCommands) or [copy a setup prompt](command:rojoHub.copyAgentPrompt) to paste into its chat."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "rojoHub.start",
        "title": "Get Started with Rojo-Hub",
        "description": "Serve several Roblox projects at once, and switch branches without Studio disconnecting.",
        "steps": [
          {
            "id": "add",
            "title": "Add a project",
            "description": "Pick a folder with a default.project.json (or another *.project.json). It gets its own port, the same on every machine.\n[Add Project](command:rojoHub.addProject)",
            "media": {
              "markdown": "media/walkthrough/add.md"
            },
            "completionEvents": [
              "onCommand:rojoHub.addProject"
            ]
          },
          {
            "id": "start",
            "title": "Start serving",
            "description": "Rojo-Hub runs rojo serve for the project in the background, so it keeps serving when VS Code windows close.\n[Open Menu](command:rojoHub.openMenu)",
            "media": {
              "markdown": "media/walkthrough/start.md"
            },
            "completionEvents": [
              "onCommand:rojoHub.start",
              "onCommand:rojoHub.startGroup"
            ]
          },
          {
            "id": "studio",
            "title": "Connect Studio",
            "description": "List the project's places in servePlaceIds, then open them in Studio: Rojo-Hub's own Studio plugin syncs them by itself. Assign other places a project in the panel's Studio places section.",
            "media": {
              "markdown": "media/walkthrough/studio.md"
            }
          },
          {
            "id": "switch",
            "title": "Switch branches live",
            "description": "Pick any worktree or branch. The same Rojo keeps running and Studio receives the difference.\n[Switch Branch](command:rojoHub.switch)",
            "media": {
              "markdown": "media/walkthrough/switch.md"
            },
            "completionEvents": [
              "onCommand:rojoHub.switch"
            ]
          },
          {
            "id": "groups",
            "title": "Group projects",
            "description": "Groups hold projects and other groups. Start runs them all; Stop keeps projects another running group uses.\n[New Group](command:rojoHub.newGroup)",
            "media": {
              "markdown": "media/walkthrough/groups.md"
            },
            "completionEvents": [
              "onCommand:rojoHub.newGroup"
            ]
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "rojoHub",
        "label": "Rojo-Hub"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && npm run smoke && tsc -p tsconfig.test.json && node --test \"out/test/*.test.js\"",
    "package": "npm run typecheck && npm run build && npm run smoke && vsce package --no-dependencies",
    "service": "node dist/service.js",
    "probe:headless": "node tools/live-switch-headless.mjs verbatim",
    "smoke": "node tools/smoke-bundle.cjs",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.101.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  }
}
