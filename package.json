{
  "name": "rojo-hub",
  "displayName": "Rojo-Hub",
  "version": "0.19.5",
  "private": true,
  "publisher": "greenviper126",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f27",
    "theme": "dark"
  },
  "description": "Serve several Rojo projects at once, each on its own fixed port, and switch any of them to another git branch while Roblox Studio stays connected.",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "roblox",
    "rojo",
    "luau",
    "roblox-studio",
    "git-worktree"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/greenviper126/RojoHub.git"
  },
  "homepage": "https://greenviper126.github.io/RojoHub/",
  "bugs": {
    "url": "https://github.com/greenviper126/RojoHub/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Rojo-Hub runs git and Rojo in your projects' folders."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
